<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StreetFlow.Dashboard</RootNamespace>
    <Description>StreetFlow Public Dashboard (PRD surface 4): static Blazor WASM page that loads anonymous records from Supabase, runs the transit analysis in the browser and shows the headline number + share card.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreetFlow.Collector.Core\StreetFlow.Collector.Core.csproj" />
    <ProjectReference Include="..\StreetFlow.Supabase\StreetFlow.Supabase.csproj" />
  </ItemGroup>

</Project>
