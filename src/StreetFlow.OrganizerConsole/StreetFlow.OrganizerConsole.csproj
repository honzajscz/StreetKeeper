<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StreetFlow.OrganizerConsole</RootNamespace>
    <Description>StreetFlow Organizer Console (PRD surface 1): static Blazor WASM page to create a campaign — client-side campaign_id, Leaflet/OSM polygon + boundary points, saved to Supabase.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreetFlow.Collector.Core\StreetFlow.Collector.Core.csproj" />
    <ProjectReference Include="..\StreetFlow.Supabase\StreetFlow.Supabase.csproj" />
  </ItemGroup>

</Project>
